# Copy to client/.env.local for local runs. On Vercel, set the same variables in
# Project → Settings → Environment Variables (then redeploy).

# ── Contact form (api/contact.js — Vercel Function, e-mail delivery through Resend) ──
# Server-side only: never prefixed with VITE_, never sent to the browser.
# While RESEND_API_KEY or CONTACT_TO_EMAIL is empty, the site replaces the form with a notice.
RESEND_API_KEY=
# Address(es) receiving the requests, comma-separated
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. OASIS GROUP <site@your-domain.ma>
# (empty: Resend's test sender, which only delivers to the Resend account's own address)
CONTACT_FROM_EMAIL=

# ── Public site configuration — all optional. Empty values are simply not displayed:
# the site never shows placeholder coordinates or legal information.

# Public address of the site, without trailing slash (social image URL, sitemap.xml).
# On Vercel it defaults to the project's production domain.
VITE_SITE_URL=

# Contact details shown in the Contact section and the footer
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
# International format, e.g. +212600000000
VITE_CONTACT_WHATSAPP=
VITE_COMPANY_ADDRESS=
VITE_CONTACT_HOURS=

# Legal information shown in the footer
VITE_LEGAL_NAME=
VITE_LEGAL_FORM=
VITE_LEGAL_RC=
VITE_LEGAL_ICE=
VITE_LEGAL_IF=

# Official social accounts (full https:// URLs)
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_FACEBOOK=
