# Public site configuration — all optional. Empty values are simply not displayed:
# the site never shows placeholder coordinates or legal information.

# Public address of the site (canonical links, sharing)
VITE_SITE_URL=

# Contact details shown in the Contact section and the footer
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
# International format, e.g. +212600000000
VITE_CONTACT_WHATSAPP=
VITE_COMPANY_ADDRESS=
VITE_CONTACT_HOURS=

# Legal information shown in the footer
VITE_LEGAL_NAME=
VITE_LEGAL_FORM=
VITE_LEGAL_RC=
VITE_LEGAL_ICE=
VITE_LEGAL_IF=

# Official social accounts (full https:// URLs)
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_FACEBOOK=
